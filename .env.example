# Copy to .env and fill in. The key stays on the server and is never sent to the browser.
# Any OpenAI-compatible chat-completions API works (Groq, OpenRouter, OpenAI, Gemini's
# OpenAI-compatible endpoint, Ollama...).

# --- Groq (free tier) - default ---
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_JSON_MODE=true

# --- Other examples ---
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
# Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=llama3.1   (no key needed)

# Set to "false" if your provider rejects response_format: json_object
# LLM_JSON_MODE=true

# Backend port for local dev
# PORT=8787
